{
    "name": "@mangalcore/ui-utils",
    "version": "0.1.0",
    "description": "Tiny React components and hooks for Next.js and AI apps: streaming LLM text, stick-to-bottom chat scroll, auto-resizing prompt input, JSON-LD SEO, copy-to-clipboard, and 30+ UI utilities. TypeScript, tree-shakable, Server Component safe.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./server": {
            "import": {
                "types": "./dist/server.d.mts",
                "default": "./dist/server.mjs"
            },
            "require": {
                "types": "./dist/server.d.ts",
                "default": "./dist/server.js"
            }
        },
        "./llms.txt": "./llms.txt",
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "server": [
                "./dist/server.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "llms.txt"
    ],
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write \"src/**/*.{ts,tsx}\"",
        "changeset": "changeset",
        "release": "changeset publish",
        "validate": "npm run lint && npm run build && tsc --noEmit",
        "demo": "cd demo && npm run dev",
        "prepare": "husky"
    },
    "keywords": [
        "react",
        "nextjs",
        "next.js",
        "app-router",
        "react-server-components",
        "typescript",
        "hooks",
        "react-hooks",
        "components",
        "ui",
        "utils",
        "tailwind",
        "ai",
        "llm",
        "chatbot",
        "chat-ui",
        "ai-chat",
        "streaming",
        "streaming-text",
        "typewriter",
        "vercel-ai-sdk",
        "openai",
        "auto-scroll",
        "stick-to-bottom",
        "textarea-autosize",
        "json-ld",
        "structured-data",
        "schema-org",
        "seo",
        "copy-to-clipboard",
        "use-debounce",
        "use-local-storage",
        "dashboard",
        "saas"
    ],
    "author": "Mangal",
    "license": "MIT",
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.1",
        "@types/node": "^20.11.0",
        "@types/qrcode.react": "^1.0.3",
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "eslint": "^8.56.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "husky": "^9.1.7",
        "prettier": "^3.2.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "lucide-react": "^0.309.0",
        "qrcode.react": "^3.1.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pananon/mangalcore-ui-utils.git"
    },
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/pananon/mangalcore-ui-utils/issues"
    },
    "homepage": "https://github.com/pananon/mangalcore-ui-utils#readme"
}
